{
  "name": "terminal-manager",
  "version": "1.0.2",
  "private": true,
  "description": "Local WSL server control center",
  "author": "Nexus Control",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "backend": "node backend/server.cjs",
    "mcp": "node mcp/server.cjs",
    "dev:full": "concurrently -k \"npm:backend\" \"npm:web\"",
    "electron:install": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npx install-electron --no",
    "dist:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "latest",
    "node-pty": "^1.1.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "wait-on": "latest"
  },
  "build": {
    "appId": "local.nexus.control",
    "productName": "Nexus Control",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release-portable"
    },
    "artifactName": "Nexus-Control-${version}-win-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/*.cjs",
      "backend/servers.example.json",
      "mcp/server.cjs",
      "docs/**/*",
      "package.json",
      "!backend/servers.json",
      "!backend/logs/**/*",
      "!backend/.runtime/**/*",
      "!backend/node_modules/**/*",
      "!src/**/*",
      "!work/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
